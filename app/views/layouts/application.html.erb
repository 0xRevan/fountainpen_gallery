<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Fountain Pen Gallery</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="nav">
      <div class="nav-left">
        <%= link_to "Fountain Pen Gallery", root_path, class: "nav-brand" %>
      </div>
      <div class="nav-right">
        <% if authenticated? %>
          <span class="nav-user"><%= Current.user&.email_address %></span>
          <%= link_to "Add New Pen", new_pen_path %>
          <%= button_to "Sign Out", session_path, method: :delete, class: "btn btn-sm btn-outline", style: "color: white; border-color: rgba(255,255,255,0.3);" %>
        <% else %>
          <%= link_to "Sign In", new_session_path %>
        <% end %>
      </div>
    </nav>

    <div class="container">
      <% if notice.present? %>
        <div class="flash flash-notice"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="flash flash-alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
