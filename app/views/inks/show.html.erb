<div class="ink-show">
  <% if @ink.image.attached? %>
    <%= image_tag @ink.image.variant(resize_to_limit: [800, 600]), class: "ink-show-image", alt: @ink.name %>
  <% end %>

  <div class="ink-show-body">
    <h1 class="ink-show-title"><%= @ink.name %></h1>
    <div class="ink-show-brand"><%= @ink.brand %></div>
    <div class="ink-show-color">
      <span class="ink-color-dot" style="background-color: <%= @ink.color.downcase %>"></span>
      <%= @ink.color %>
    </div>
    <div class="ink-show-price"><%= number_to_currency(@ink.price) %></div>

    <% if @ink.description.present? %>
      <p class="ink-show-description"><%= @ink.description %></p>
    <% end %>

    <div class="ink-show-meta">
      Added <%= time_ago_in_words(@ink.created_at) %> ago
      <% if @ink.updated_at > @ink.created_at + 1.minute %>
        &middot; Updated <%= time_ago_in_words(@ink.updated_at) %> ago
      <% end %>
    </div>

    <div class="ink-show-actions">
      <%= link_to "Back to Inks", inks_path, class: "btn btn-outline" %>
      <% if authenticated? %>
        <%= link_to "Edit", edit_ink_path(@ink), class: "btn btn-primary" %>
        <%= button_to "Delete", ink_path(@ink), method: :delete, class: "btn btn-danger",
              form: { data: { turbo_confirm: "Are you sure you want to delete this ink?" } } %>
      <% end %>
    </div>
  </div>
</div>
