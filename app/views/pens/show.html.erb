<div class="pen-show">
  <% if @pen.image.attached? %>
    <%= image_tag @pen.image.variant(resize_to_limit: [800, 600]), class: "pen-show-image", alt: @pen.title %>
  <% end %>

  <div class="pen-show-body">
    <h1 class="pen-show-title"><%= @pen.title %></h1>
    <div class="pen-show-price"><%= number_to_currency(@pen.price) %></div>

    <% if @pen.description.present? %>
      <p class="pen-show-description"><%= @pen.description %></p>
    <% end %>

    <div class="pen-show-meta">
      Added <%= time_ago_in_words(@pen.created_at) %> ago
      <% if @pen.updated_at > @pen.created_at + 1.minute %>
        &middot; Updated <%= time_ago_in_words(@pen.updated_at) %> ago
      <% end %>
    </div>

    <div class="pen-show-actions">
      <%= link_to "Back to Collection", pens_path, class: "btn btn-outline" %>
      <% if authenticated? %>
        <%= link_to "Edit", edit_pen_path(@pen), class: "btn btn-primary" %>
        <%= button_to "Delete", pen_path(@pen), method: :delete, class: "btn btn-danger",
              form: { data: { turbo_confirm: "Are you sure you want to delete this pen?" } } %>
      <% end %>
    </div>
  </div>
</div>
