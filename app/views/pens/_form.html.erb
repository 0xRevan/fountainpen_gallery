<%= form_with(model: pen) do |f| %>
  <% if pen.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(pen.errors.count, "error") %> prevented this pen from being saved:</h2>
      <ul>
        <% pen.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title, "Pen Name", class: "form-label" %>
    <%= f.text_field :title, class: "form-input", placeholder: "e.g., Pilot Metropolitan" %>
  </div>

  <div class="form-group">
    <%= f.label :description, "Description", class: "form-label" %>
    <%= f.text_area :description, class: "form-input", rows: 5, placeholder: "What makes this pen special?" %>
  </div>

  <div class="form-group">
    <%= f.label :price, "Price", class: "form-label" %>
    <%= f.number_field :price, class: "form-input", step: 0.01, min: 0.01 %>
  </div>

  <div class="form-group">
    <%= f.label :image, "Photo", class: "form-label" %>
    <%= f.file_field :image, class: "form-input", accept: "image/png,image/jpeg,image/webp,image/gif" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>
